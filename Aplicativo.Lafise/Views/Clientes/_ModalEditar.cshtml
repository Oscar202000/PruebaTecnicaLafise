<div class="modal fade" id="editarModal" tabindex="-1" role="dialog" aria-labelledby="editarModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editarModalLabel">Editar Cliente</h5>
                <!-- Botón “X” -->
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editarId" />
                <input type="text" id="editarNombre" class="form-control mb-2" placeholder="Nombre" />
                <input type="text" id="editarIdentificacion" class="form-control mb-2" placeholder="Identificación" />
            </div>

            <div class="modal-footer">
                <button type="button" id="guardarEdicion" class="btn btn-primary">Guardar Cambios</button>
                <!-- Botón “Cerrar” -->
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>
