@{
    ViewData["Title"] = "Gestión Cliente";
    Layout = "_Layout";
}
<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <!-- Filtros -->
    <div class="row mb-3">
        <div class="col">
            <input id="filtroNombre" class="form-control" placeholder="Filtrar por Nombre" />
        </div>
        <div class="col">
            <input id="filtroIdent" class="form-control" placeholder="Filtrar por Identificación" />
        </div>
    </div>

    <!-- Tabla -->
    <table class="table table-hover" id="tablaClientes">
        <thead class="thead-light">
            <tr>
                <th>Nombre</th>
                <th>Identificación</th>
            </tr>
        </thead>
        <tbody id="tablaClientesBody"></tbody>
    </table>

    <div class="mb-3">
        <button id="btnAgregar" class="btn btn-primary mr-2">Agregar</button>
        <button id="btnModificar" class="btn btn-warning mr-2">Modificar</button>
        <button id="btnEliminar" class="btn btn-danger">Eliminar</button>
    </div>

    <!-- Alerta flotante -->
    <div id="alertMessage" class="alert d-none position-fixed" style="top:1rem;right:1rem;z-index:2000;"></div>
</div>

@* Modales *@
<partial name="_ModalCrear" />
<partial name="_ModalEditar" />

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/clientes.js"></script>
}
