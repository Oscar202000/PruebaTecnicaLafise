<div class="modal fade" id="crearModal" tabindex="-1" role="dialog" aria-labelledby="crearModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="crearModalLabel">Agregar Cliente</h5>
                <!-- Botón “X” -->
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <input type="text" id="nuevoNombre" class="form-control mb-2" placeholder="Nombre" />
                <input type="text" id="nuevaIdentificacion" class="form-control mb-2" placeholder="Identificación" />
                <input type="text" id="nuevoSaldo" class="form-control mb-2" placeholder="Saldo Disponible" />
            </div>

            <div class="modal-footer">
                <button type="button" id="guardarNuevo" class="btn btn-success">Guardar</button>
                <!-- Botón “Cerrar” -->
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>
