@{
    ViewData["Title"] = "Gestión de Cuentas";
    Layout = "_Layout";
}
<div class="container mt-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="row mb-3">
        <div class="col">
            <input id="filtroNombre" class="form-control" placeholder="Filtrar por Nombre" />
        </div>
        <div class="col">
            <input id="filtroIdent" class="form-control" placeholder="Filtrar por Identificación" />
        </div>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>NumeroCuenta</th>
                <th>Nombre</th>
                <th>Identificación</th>
                <th>Saldo Disponible</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody id="tablaCuentasBody"></tbody>
    </table>
    <div class="mb-3">
        <button id="btnAgregarCuenta" class="btn btn-primary">Agregar Cuenta</button>
        <button id="btnModificarCuenta" class="btn btn-warning">Modificar Cuenta</button>
        <button id="btnEliminarCuenta" class="btn btn-danger">Eliminar Cuenta</button>
    </div>
</div>

@* Modales *@
<partial name="_ModalCrearCuenta" />
<partial name="_ModalEditarCuenta" />

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="~/js/cuentas.js"></script>
}
