<div class="modal fade" id="editarModalCuenta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modificar Cuenta</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editarCuentaId" />

                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" id="editarNombreCuenta" class="form-control" disabled />
                </div>
                <div class="form-group">
                    <label>Identificación</label>
                    <input type="text" id="editarIdentificacionCuenta" class="form-control" disabled />
                </div>
                <div class="form-group">
                    <label>Saldo Disponible</label>
                    <input type="number" id="editarSaldo" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Estado</label>
                    <select id="editarEstado" class="form-control">
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button id="guardarEdicionCuenta" class="btn btn-primary">Guardar Cambios</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
