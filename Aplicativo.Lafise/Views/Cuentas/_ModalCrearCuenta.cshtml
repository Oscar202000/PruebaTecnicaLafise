<div class="modal fade" id="crearModalCuenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Cuenta</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <label for="selectCliente">Cliente</label>
                <select id="selectCliente" class="form-control mb-2">
                    <option value="">-- Seleccione Cliente --</option>
                </select>
                <label for="nuevoSaldo">Saldo Disponible</label>
                <input type="number" id="nuevoSaldo" class="form-control mb-2" placeholder="2000" />
                <!-- Estado se puede omitir si siempre nuevo es 'Activo' -->
            </div>
            <div class="modal-footer">
                <button id="guardarNuevaCuenta" class="btn btn-success">Guardar</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
